{
  "name": "better-auth-elysia-obo-2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "better-auth": "1.5.2",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @better-auth-elysia-obo-2/db db:push",
    "db:studio": "bun run --filter @better-auth-elysia-obo-2/db db:studio",
    "db:generate": "bun run --filter @better-auth-elysia-obo-2/db db:generate",
    "db:migrate": "bun run --filter @better-auth-elysia-obo-2/db db:migrate",
    "db:local": "bun run --filter @better-auth-elysia-obo-2/db db:local"
  },
  "dependencies": {
    "@better-auth-elysia-obo-2/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth-elysia-obo-2/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10"
}
